{
  "name": "easy-text",
  "version": "0.5.1",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "vite build --base=./",
    "test": "node --test src/*.test.js",
    "desktop": "npm run build && electron .",
    "test:desktop": "node --test desktop-tests/*.test.mjs",
    "package:mac": "npm run build && NODE_USE_ENV_PROXY=1 node desktop/package.mjs",
    "package:dmg": "npm run package:mac && node desktop/dmg.mjs"
  },
  "dependencies": {
    "@codemirror/autocomplete": "^6.18.0",
    "@codemirror/commands": "^6.8.0",
    "@codemirror/lang-css": "^6.3.0",
    "@codemirror/lang-html": "^6.4.0",
    "@codemirror/lang-javascript": "^6.2.0",
    "@codemirror/lang-json": "^6.0.0",
    "@codemirror/lang-markdown": "^6.3.0",
    "@codemirror/lang-python": "^6.2.0",
    "@codemirror/language": "^6.10.0",
    "@codemirror/search": "^6.5.0",
    "@codemirror/state": "^6.5.0",
    "@codemirror/theme-one-dark": "^6.1.0",
    "@codemirror/view": "^6.36.0",
    "codemirror": "^6.0.1",
    "vite": "^6.1.0"
  },
  "devDependencies": {
    "@electron/packager": "^20.3.0",
    "electron": "^45.0.0"
  },
  "productName": "easy text",
  "main": "desktop/main.mjs"
}
